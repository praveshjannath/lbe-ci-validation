#!/bin/sh
set -eu

fail() {
  echo "LBE WORKSPACE LOCK: BLOCKED: $1" >&2
  exit 1
}

remote_name="${1:-}"
remote_url="${2:-}"

[ "$remote_name" = "origin" ] || fail "push remote must be origin (got: ${remote_name:-<none>})"
case "$remote_url" in
  *Letterblack0306/LBE_Presistent_Agent_wall* ) ;;
  * ) fail "origin does not resolve to canonical Letterblack0306/LBE_Presistent_Agent_wall" ;;
esac

branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
[ "$branch" = "main" ] || fail "current branch must be main; detached/non-main HEAD is forbidden"

root="$(git rev-parse --show-toplevel)"
primary="$(git worktree list --porcelain | awk 'NR==1 && $1=="worktree" { sub(/^worktree /, ""); print; exit }')"
[ -n "$primary" ] || fail "cannot resolve primary worktree"

root_norm="$(cd "$root" && pwd -P)"
primary_norm="$(cd "$primary" && pwd -P)"
[ "$root_norm" = "$primary_norm" ] || fail "push from a secondary worktree is forbidden"

for marker in MERGE_HEAD REBASE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
  if git rev-parse -q --verify "$marker" >/dev/null 2>&1; then
    fail "Git operation in progress: $marker"
  fi
done

head_sha="$(git rev-parse HEAD)"
seen=0
while read -r local_ref local_sha remote_ref remote_sha; do
  seen=1
  [ "$local_ref" = "refs/heads/main" ] || fail "only refs/heads/main may be pushed (got: $local_ref)"
  [ "$remote_ref" = "refs/heads/main" ] || fail "only origin/main may be updated (got: $remote_ref)"
  [ "$local_sha" = "$head_sha" ] || fail "pushed main SHA must equal current canonical HEAD"
done

[ "$seen" -eq 1 ] || fail "no push update received"

echo "LBE WORKSPACE LOCK: PASS — canonical primary-worktree main -> origin/main"
exit 0
